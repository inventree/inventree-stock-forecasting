    "@vitejs/plugin-react": "^4.7.0",
    "@vitejs/plugin-react-swc": "latest",
    "globals": "^15.14.0",
    "typescript": "~5.6.2",
    "vite": "^6.4.2",
    "vite-plugin-externals": "^0.6.2"
